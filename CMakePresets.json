{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "environment": {
        "VCPKG_ROOT": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\vcpkg"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}\\scripts\\buildsystems\\vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "environment": {
        "VCPKG_ROOT": "/opt/vcpkg"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },

    {
      "name": "debug-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": "linux-base",
      "environment": {
        "VCPKG_ROOT": "/opt/vcpkg",
        "CC": "clang-18",
        "CXX": "clang++-18"
      }
    },
    {
      "name": "sanitizers-base",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON"
      }
    },

    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": [ "windows-base", "debug-base" ]
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": [ "windows-base", "release-base" ]
    },
    {
      "name": "x64-relwithdebinfo",
      "displayName": "x64 RelWithDebInfo",
      "inherits": [ "windows-base", "relwithdebinfo-base" ]
    },

    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": [ "linux-base", "debug-base" ]
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": [ "linux-base", "release-base" ]
    },
    {
      "name": "linux-relwithdebinfo",
      "displayName": "Linux RelWithDebInfo",
      "inherits": [ "linux-base", "relwithdebinfo-base" ]
    },
    {
      "name": "linux-asan-ubsan",
      "displayName": "Linux ASan UBSan",
      "inherits": [ "linux-base", "debug-base", "sanitizers-base" ]
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": [ "linux-clang-base", "debug-base" ]
    },
    {
      "name": "linux-clang-asan-ubsan",
      "displayName": "Linux Clang ASan UBSan",
      "inherits": [ "linux-clang-base", "debug-base", "sanitizers-base" ]
    }
  ],
  "buildPresets": [
    {
      "name": "build-base",
      "hidden": true,
      "jobs": 12
    },
    {
      "name": "build-verbose",
      "hidden": true,
      "inherits": "build-base",
      "verbose": true
    },

    {
      "name": "x64-debug",
      "inherits": "build-base",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "inherits": "build-base",
      "configurePreset": "x64-release"
    },
    {
      "name": "x64-relwithdebinfo",
      "inherits": "build-base",
      "configurePreset": "x64-relwithdebinfo"
    },
    {
      "name": "linux-debug",
      "inherits": "build-base",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "build-base",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-relwithdebinfo",
      "inherits": "build-base",
      "configurePreset": "linux-relwithdebinfo"
    },

    {
      "name": "x64-debug-verbose",
      "inherits": "build-verbose",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release-verbose",
      "inherits": "build-verbose",
      "configurePreset": "x64-release"
    },
    {
      "name": "x64-relwithdebinfo-verbose",
      "inherits": "build-verbose",
      "configurePreset": "x64-relwithdebinfo"
    },
    {
      "name": "linux-debug-verbose",
      "inherits": "build-verbose",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release-verbose",
      "inherits": "build-verbose",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-relwithdebinfo-verbose",
      "inherits": "build-verbose",
      "configurePreset": "linux-relwithdebinfo"
    },
    {
      "name": "linux-asan-ubsan",
      "inherits": "build-base",
      "configurePreset": "linux-asan-ubsan"
    },
    {
      "name": "linux-clang-debug",
      "inherits": "build-base",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "linux-clang-asan-ubsan",
      "inherits": "build-base",
      "configurePreset": "linux-clang-asan-ubsan"
    },
    {
      "name": "linux-asan-ubsan-verbose",
      "inherits": "build-verbose",
      "configurePreset": "linux-asan-ubsan"
    },
    {
      "name": "linux-clang-debug-verbose",
      "inherits": "build-verbose",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "linux-clang-asan-ubsan-verbose",
      "inherits": "build-verbose",
      "configurePreset": "linux-clang-asan-ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "test-quiet",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 300,
        "stopOnFailure": false
      }
    },
    {
      "name": "test-verbose",
      "hidden": true,
      "inherits": "test-quiet",
      "output": {
        "outputOnFailure": true,
        "shortProgress": false,
        "verbosity": "verbose"
      }
    },
    {
      "name": "test-fast",
      "hidden": true,
      "inherits": "test-quiet",
      "output": {
        "outputOnFailure": true,
        "shortProgress": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 1,
        "stopOnFailure": true
      }
    },

    {
      "name": "x64-debug",
      "inherits": "test-quiet",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "inherits": "test-quiet",
      "configurePreset": "x64-release"
    },
    {
      "name": "x64-relwithdebinfo",
      "inherits": "test-quiet",
      "configurePreset": "x64-relwithdebinfo"
    },
    {
      "name": "linux-debug",
      "inherits": "test-quiet",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "test-quiet",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-relwithdebinfo",
      "inherits": "test-quiet",
      "configurePreset": "linux-relwithdebinfo"
    },

    {
      "name": "x64-debug-verbose",
      "inherits": "test-verbose",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release-verbose",
      "inherits": "test-verbose",
      "configurePreset": "x64-release"
    },
    {
      "name": "x64-relwithdebinfo-verbose",
      "inherits": "test-verbose",
      "configurePreset": "x64-relwithdebinfo"
    },
    {
      "name": "linux-debug-verbose",
      "inherits": "test-verbose",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release-verbose",
      "inherits": "test-verbose",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-relwithdebinfo-verbose",
      "inherits": "test-verbose",
      "configurePreset": "linux-relwithdebinfo"
    },

    {
      "name": "x64-debug-fast",
      "inherits": "test-fast",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release-fast",
      "inherits": "test-fast",
      "configurePreset": "x64-release"
    },
    {
      "name": "linux-debug-fast",
      "inherits": "test-fast",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release-fast",
      "inherits": "test-fast",
      "configurePreset": "linux-release"
    },

    {
      "name": "linux-asan-ubsan",
      "inherits": "test-quiet",
      "configurePreset": "linux-asan-ubsan"
    },
    {
      "name": "linux-clang-debug",
      "inherits": "test-quiet",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "linux-clang-asan-ubsan",
      "configurePreset": "linux-clang-asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:symbolize=1",
        "ASAN_SYMBOLIZER_PATH": "/usr/bin/llvm-symbolizer-18",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "linux-asan-ubsan-verbose",
      "inherits": "test-verbose",
      "configurePreset": "linux-asan-ubsan"
    },
    {
      "name": "linux-clang-debug-verbose",
      "inherits": "test-verbose",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "linux-clang-asan-ubsan-verbose",
      "inherits": "test-verbose",
      "configurePreset": "linux-clang-asan-ubsan"
    },
    {
      "name": "linux-asan-ubsan-fast",
      "inherits": "test-fast",
      "configurePreset": "linux-asan-ubsan"
    },
    {
      "name": "linux-clang-debug-fast",
      "inherits": "test-fast",
      "configurePreset": "linux-clang-debug"
    }
  ]
}